# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only (no NEXT_PUBLIC_ prefix). Public URL of this site, used for the link in
# confirmation emails, e.g. https://shop.example.com. Falls back to the request host if unset.
# NEVER put the Supabase service_role key in any NEXT_PUBLIC_ variable.
SITE_URL=
